<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>dev.webplayer</groupId>
    <artifactId>webplayer</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <ytdlp.version>latest</ytdlp.version>
        <byte-buddy.version>1.18.11</byte-buddy.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

        <!-- Test infrastructure: JUnit 5, Mockito, AssertJ, MockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- ── Spring Boot fat JAR ────────────────────────────────────────── -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- ── Download yt-dlp binary at build time ──────────────────────── -->
            <!--   Runs before compile so the binary lands in resources/native/   -->
            <!--   and gets packed into the fat JAR automatically.                -->
            <!--   The [ -f ... ] guard skips the download if already present,    -->
            <!--   so incremental builds stay fast.                               -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>download-yt-dlp</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>
                                    mkdir -p src/main/resources/native;
                                    if [ ! -f src/main/resources/native/yt-dlp ]; then
                                    echo "[webplayer] Downloading yt-dlp binary...";
                                    curl -L --progress-bar -o src/main/resources/native/yt-dlp https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp;
                                    chmod +x src/main/resources/native/yt-dlp;
                                    echo "[webplayer] yt-dlp downloaded.";
                                    else
                                    echo "[webplayer] yt-dlp already present, skipping download.";
                                    fi
                                </argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <!-- ── Build React frontend before packaging ─────────────────── -->
                    <execution>
                        <id>build-frontend</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>-c</argument>
                                <argument>
                                    cd src/frontend;
                                    npm ci;
                                    npm run build
                                </argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>

        <!-- ── Resources: include frontend dist + native binaries ────────── -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Vite build output → classpath:/static/ (Spring auto-serves it) -->
            <resource>
                <directory>src/frontend/dist</directory>
                <targetPath>static</targetPath>
            </resource>
        </resources>
    </build>

    <!-- ── Profile: bundle JRE with jpackage ─────────────────────────────── -->
    <!--   Usage: mvn package -Pjpackage                                       -->
    <!--   Requires JDK 14+ (jpackage is bundled with the JDK).               -->
    <!--   Output: target/dist/WebPlayer/  (self-contained app image)         -->
    <profiles>
        <profile>
            <id>jpackage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>run-jpackage</id>
                                <!-- Runs after the fat JAR is built -->
                                <phase>verify</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>jpackage</executable>
                                    <arguments>
                                        <!-- App image = self-contained directory, no installer needed -->
                                        <argument>--type</argument>
                                        <argument>app-image</argument>

                                        <argument>--name</argument>
                                        <argument>WebPlayer</argument>

                                        <argument>--app-version</argument>
                                        <argument>${project.version}</argument>

                                        <!-- Where to find the fat JAR -->
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}</argument>

                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>

                                        <argument>--main-class</argument>
                                        <argument>MPD.WebPlayerApplication</argument>

                                        <!-- Output directory -->
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/dist</argument>

                                        <!-- JVM flags -->
                                        <argument>--java-options</argument>
                                        <argument>--enable-native-access=ALL-UNNAMED</argument>

                                        <!-- Linux-specific -->
                                        <argument>--linux-app-category</argument>
                                        <argument>AudioVideo</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>